node_modules/

# ── Зависимости ───────────────────────────────────────────────────────────
# `vendor/` — результат `composer install`, а не исходник. До правки он был
# ЗАКОММИЧЕН: 18 627 из 19 868 файлов индекса (93%) были `vendor/` и
# `node_modules/`, `.git` весил 132 МБ, а каждый клоон тянул 100 МБ чужого
# кода, который к тому же расходится с `composer.lock` при первом же
# `composer install`. Зависимости ставятся из `composer.lock`, который
# отслеживается, — поэтому восстановление после клона одношаговое.
vendor/

# ── Секреты ────────────────────────────────────────────────────────────────
# `.env` не отслеживался, но и НЕ игнорировался — то есть был незащищён: одного
# `git add -A` хватало, чтобы пароль БД, ключ YooKassa и OAuth-токен Яндекс.Диска
# уехали в репозиторий. `.env.example` — шаблон без значений, он отслеживается
# намеренно, поэтому исключается обратно (порядок правил важен: последнее
# совпадение побеждает).
.env
.env.*
!.env.example

# ── Локальные артефакты ────────────────────────────────────────────────────
# Сборка витрины. Деплой-артефакт — `public_html/`, а `dist/` собирается на
# месте; страница события отдаёт 503, пока сборки нет (это осознанное поведение,
# а не поломка).
/dist

# `php artisan storage:link` — символическая ссылка на storage/app/public,
# создаётся локально. В репозитории она бессмысленна и ломается на чужой ОС.
/public/storage

# Кеш PHPUnit: результат предыдущего прогона, к коду отношения не имеет.
.phpunit.result.cache

# Логи и одноразовые выгрузки локальных прогонов.
*.log
debug.log
cache-*.bin
cache-cleanup.sql

# Следы `2>nul` из cmd.exe. Файл с таким именем на Windows нельзя ни удалить,
# ни открыть, но и коммитить его незачем.
nul

# Одноразовые скрипты проверок.
tools/.tmp-*
