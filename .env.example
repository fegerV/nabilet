# ─────────────────────────────────────────────────────────────────────────────
# NABILET Core — environment template
#
# Copy to `.env` and fill in. The installer (/install) writes this file for you.
# NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="NABILET"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Moscow
APP_URL=https://tickets.example.com

# Comma-separated list of locales the catalog is published in (ТЗ §39).
APP_LOCALES=ru,en
APP_FALLBACK_LOCALE=ru

# ── Database ─────────────────────────────────────────────────────────────────
# MySQL 8.4 is the sole supported target (ТЗ §3). MariaDB 10.2+ also works.
# Shared hosting: confirm the host allows CREATE TRIGGER — see
# database/migrations/2026_09_20_001100_add_schema_version_immutability_trigger.php.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nabilet
DB_USERNAME=nabilet
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Pool size guideline: (CPU cores x 2) + spindle count. Start at 10-20.
DB_POOL_SIZE=15

# ── Cache / Queue / Session ──────────────────────────────────────────────────
# IMPORTANT (ТЗ §3): Redis is OPTIONAL. Every driver below must have a working
# fallback so a host without Redis still runs. Never make the system depend on it.
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file

# Fallbacks used automatically when Redis is unreachable:
#   CACHE_STORE=database   QUEUE_CONNECTION=database   SESSION_DRIVER=database

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_PREFIX=nabilet_

# ── Files / Storage ──────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
# S3-compatible: AWS S3, Yandex Object Storage, MinIO (ТЗ §3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ru-central1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Ticketing core ───────────────────────────────────────────────────────────
# ВНИМАНИЕ: эта переменная НЕ управляет сроком удержания места, вопреки прежнему
# комментарию здесь. Она читается ТОЛЬКО в config/queue.php как `retry_after`
# очереди. Правка значения на длительность холда не влияет.
NABILET_HOLD_TTL=600

# Реальный срок удержания места до оплаты, в МИНУТАХ (ТЗ §24).
# config/nabilet.php → checkout.hold_duration_minutes → carts.expires_at.
# Допустимый диапазон по ТЗ — 5–30; по умолчанию 15.
CHECKOUT_HOLD_DURATION=15

# Максимум билетов в одном заказе (anti-scalping guard).
# Источник истины: его проверяет CartController::addItem(), а витрина получает
# это число в `meta.max_tickets_per_order` от GET /inventory. Дублировать на
# клиенте не нужно — менять только здесь.
CHECKOUT_MAX_ITEMS=10

# Grace-окно после истечения холда, в минутах: сколько ещё платёж считается
# валидным после `carts.expires_at`, прежде чем sweeper вернёт места в продажу.
# Источник истины один — `nabilet.checkout.hold_grace_minutes`. Читают его:
# HoldSweeper (sweep + expireStaleOrders + isHoldConvertible),
# Orders\Models\SeatHold::isConvertible() и
# Payments\Services\PaymentService::isHoldConvertible().
# ВНИМАНИЕ: рассинхрон этих трёх мест означал бы, что оплата в grace-окне
# приходит на уже освобождённое место. Меняйте только здесь.
CHECKOUT_HOLD_GRACE_MINUTES=5

# Secret used to sign QR payloads (ТЗ §30). Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
# Rotating this invalidates every issued QR code — do not rotate casually.
NABILET_QR_SECRET=

# Secret for signing outgoing webhooks (HMAC-SHA256, ТЗ §47).
NABILET_WEBHOOK_SECRET=

# НЕ ИСПОЛЬЗУЕТСЯ. Ни один env() эту переменную не читает — лимит задаётся
# выше через CHECKOUT_MAX_ITEMS. Оставлено закомментированным как напоминание:
# здесь стояло 8, оператор считал, что «anti-scalping guard» равен восьми, а
# система фактически пропускала 10, потому что контроллер держал литерал.
#NABILET_MAX_SEATS_PER_ORDER=8

# ── Payments ─────────────────────────────────────────────────────────────────
PAYMENTS_DEFAULT_PROVIDER=yookassa
# Локальный демо-режим: POST /payments создаёт платёж «demo_*», POST /payments/demo-pay
# симулирует вебхук payment.succeeded. В продакшене оставить false/удалить.
PAYMENT_DEMO_MODE=true
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL="${APP_URL}/checkout/return"
YOOKASSA_WEBHOOK_IP_ALLOWLIST=
# Необязательно: только для установок, проксирующих уведомления (теряется исходный IP).
YOOKASSA_WEBHOOK_SECRET=
# Эти провайдеры подписывают уведомления HMAC-SHA256 — секрет обязателен, иначе уведомления не принимаются.
STRIPE_WEBHOOK_SECRET=
KASPI_WEBHOOK_SECRET=

# ── Яндекс Метрика / Директ (config/metrika.php) ────────────────────────────
# ID счётчика Метрики (число из кода вставки). 0/пусто — интеграция выключена.
YANDEX_METRIKA_COUNTER_ID=0
# Ключ аутентификации счётчика (&ct= из кода вставки). Нужен, если счётчик
# размещён на другом домене; секрет — только в .env, не через админ-UI.
YANDEX_METRIKA_COUNTER_AUTH=
# Тип счётчика: web — обычный сайт/SPA, hit — только события без pageView.
YANDEX_METRIKA_COUNTER_TYPE=web
# Безопасный режим (clickBeacon:false, WebVisor off) — true/false.
YANDEX_METRIKA_SAFE_MODE=false
# Загрузка скрипта с cdn.jsdelivr.net (без cookie-домена Яндекса) — true/false.
YANDEX_METRIKA_ACCURATE_TRACK=false
# Товарная e-commerce фича (params.product для целей корзины/заказа) — true/false.
YANDEX_METRIKA_ECOMMERCE=true
# Валюта для params.revenue у цели покупки (для стратегий Директа с оплатой).
YANDEX_METRIKA_CURRENCY=RUB

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="tickets@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Telegram (ТЗ §44-45) ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ── Observability (ТЗ §4) ────────────────────────────────────────────────────
SENTRY_LARAVEL_DSN=
LOG_CHANNEL=stack
LOG_LEVEL=warning

# ── Security ─────────────────────────────────────────────────────────────────
# Comma-separated. NEVER use "*" in production (ТЗ §79).
CORS_ALLOWED_ORIGINS=https://tickets.example.com

# Trusted proxy IPs — set this behind a load balancer so client IPs are real.
TRUSTED_PROXIES=

# GeoIP database for country-level IP filtering (ТЗ §57). Optional.
GEOIP_DATABASE_PATH=

# ── Feature flags ────────────────────────────────────────────────────────────
FEATURE_EMBED=true
FEATURE_AB_TESTING=false
FEATURE_HEATMAPS=false
FEATURE_AI=false
# Session recording is architecturally possible but OFF by default (ТЗ §55).
FEATURE_SESSION_RECORDING=false
