{
  "name": "nabilet-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NABILET Core — Vue-сборка: конструктор схем залов, конструктор билетов, дизайн-система интерфейсов",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:preview": "vite build --config vite.preview.config.ts && node tools/inline-preview.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vue/test-utils": "^2.5.1",
    "axios": "^1.6.8",
    "jsdom": "^29.1.1",
    "konva": "^9.3.16",
    "pinia": "^2.2.6",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.1.10"
  }
}
