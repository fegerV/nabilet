{
    "name": "nabilet/core",
    "type": "project",
    "description": "NABILET Core \u2014 universal ticketing engine (modular monolith: commerce, ticketing, CMS, integrations).",
    "keywords": [
        "ticketing",
        "events",
        "seating",
        "laravel",
        "modular-monolith"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "filament/filament": "^3.2",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "predis/predis": "^2.2",
        "symfony/http-foundation": "^7.0",
        "symfony/var-dumper": "^8.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.17",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Nabilet\\Core\\": "app/Core/",
            "Nabilet\\Modules\\": "app/Modules/",
            "Nabilet\\Plugins\\": "plugins/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Core/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Nabilet\\Tests\\": "tests/",
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "test": [
            "php tests/run.php"
        ],
        "lint": [
            "php tools/lint.php"
        ],
        "verify": [
            "@lint",
            "@test",
            "php tools/verify-openapi.php",
            "php tools/verify-migrations.php",
            "php tools/verify-state-machines.php"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
