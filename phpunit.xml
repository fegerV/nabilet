<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <!--
            MySQL 8.4 — disposable Feature-test database. RefreshDatabase drops and
            rebuilds every table on each run, so this target must never be used for
            audit records or application data. It is deliberately distinct from both
            .env's `nabilet` and the former `nabilet_testing` audit database.

            The DB_* values are forced so inherited shell/CI variables cannot redirect
            migrate:fresh to a different database. Create `nabilet_test_suite` once in
            the local test MySQL instance before running the Feature suite.
        -->
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="3307" force="true"/>
        <env name="DB_DATABASE" value="nabilet_test_suite" force="true"/>
        <env name="DB_USERNAME" value="root" force="true"/>
        <env name="DB_PASSWORD" value="rootpass" force="true"/>
        <env name="DB_CHARSET" value="utf8mb4" force="true"/>
        <env name="DB_COLLATION" value="utf8mb4_unicode_ci" force="true"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
    </php>
</phpunit>