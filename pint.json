{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "not_operator_with_successor_space": true,
        "trailing_comma_in_multiline": {
            "elements": ["arrays", "arguments", "parameters"]
        },
        "phpdoc_align": false,
        "no_unused_imports": true
    },
    "exclude": [
        "vendor",
        "storage",
        "bootstrap/cache",
        "nabilet_core_spec"
    ]
}
