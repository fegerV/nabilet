# ─────────────────────────────────────────────────────────────────────────────
# NABILET Core — environment template
#
# Copy to `.env` and fill in. The installer (/install) writes this file for you.
# NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="NABILET"
APP_ENV=local
APP_KEY=base64:vV/k6YBgbWTcsiOSgOLqGjexUx1J5xe8zXMxYkvD7gQ=
APP_DEBUG=true
APP_TIMEZONE=Europe/Moscow
APP_URL=https://tickets.example.com

# Comma-separated list of locales the catalog is published in (ТЗ §39).
APP_LOCALES=ru,en
APP_FALLBACK_LOCALE=ru

# ── Database ─────────────────────────────────────────────────────────────────
# MySQL 8 / MariaDB is the primary target; PostgreSQL support is planned (ТЗ §3).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nabilet
DB_USERNAME=nabilet
DB_PASSWORD=aR5mp7BwTvpCbZ0ppB0c
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Pool size guideline: (CPU cores x 2) + spindle count. Start at 10-20.
DB_POOL_SIZE=15

# ── Cache / Queue / Session ──────────────────────────────────────────────────
# IMPORTANT (ТЗ §3): Redis is OPTIONAL. Every driver below must have a working
# fallback so a host without Redis still runs. Never make the system depend on it.
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file

# Fallbacks used automatically when Redis is unreachable:
#   CACHE_STORE=database   QUEUE_CONNECTION=database   SESSION_DRIVER=database

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=PJSvrbJL1XoDu0RnPFsp
REDIS_PORT=6379
REDIS_PREFIX=nabilet_

# ── Files / Storage ──────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
# S3-compatible: AWS S3, Yandex Object Storage, MinIO (ТЗ §3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=YMQXPdeO7Xkconjo7droFkuAxcpDmu
AWS_DEFAULT_REGION=ru-central1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Ticketing core ───────────────────────────────────────────────────────────
# How long a selected seat stays reserved before payment (ТЗ §24). Seconds.
NABILET_HOLD_TTL=600

# Grace period after hold expiry before the sweeper releases it. Keeps a buyer
# who is mid-checkout from losing their seat to a clock tick.
NABILET_HOLD_GRACE=30

# Secret used to sign QR payloads (ТЗ §30). Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
# Rotating this invalidates every issued QR code — do not rotate casually.
NABILET_QR_SECRET=34c90aa33209256512d1c3b387b8d333165b99b38fcb42d4150a73156aad84d0

# Secret for signing outgoing webhooks (HMAC-SHA256, ТЗ §47).
NABILET_WEBHOOK_SECRET=df84a1113dfdf6b5f740f8e540b8e6395bb0f649e543688c0bcd65a35bd9f9c1

# Max seats per order — anti-scalping guard.
NABILET_MAX_SEATS_PER_ORDER=8

# ── Payments ─────────────────────────────────────────────────────────────────
PAYMENTS_DEFAULT_PROVIDER=yookassa
# Локальный демо-режим: POST /payments создаёт платёж «demo_*», POST /payments/demo-pay
# симулирует вебхук payment.succeeded. В продакшене оставить false/удалить.
PAYMENT_DEMO_MODE=true
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=ag_9f14d54f440a2c82998320ddc4e80db99d1323940696cbd2e2a15f0fd3a32e18
YOOKASSA_RETURN_URL="${APP_URL}/checkout/return"
YOOKASSA_WEBHOOK_IP_ALLOWLIST=
# Необязательно: только для установок, проксирующих уведомления (теряется исходный IP).
YOOKASSA_WEBHOOK_SECRET=caeb34afb6a3a703062eb866d51318d888f9e8997c89b1b3a37445a296f1722c
# Эти провайдеры подписывают уведомления HMAC-SHA256 — секрет обязателен, иначе уведомления не принимаются.
STRIPE_WEBHOOK_SECRET=whsec_ZQgMBkDE0smqv5dNcrFuTBZZQTio3FSD
KASPI_WEBHOOK_SECRET=45dcfbd0be21e3565b991c547ef6187f1e0865d5ced12bae284a070e2faeb8ca

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=5ed6lcpBZavzEhs1L7bo
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="tickets@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Telegram (ТЗ §44-45) ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=REPLACE_ME_REISSUE_VIA_PROVIDER
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=362d13c8e3c01c6bddf4ec077b33fb4294d55aacd4c161845c3d6ca057ca06e2

# ── Observability (ТЗ §4) ────────────────────────────────────────────────────
SENTRY_LARAVEL_DSN=
LOG_CHANNEL=stack
LOG_LEVEL=warning

# ── Security ─────────────────────────────────────────────────────────────────
# Comma-separated. NEVER use "*" in production (ТЗ §79).
CORS_ALLOWED_ORIGINS=https://tickets.example.com

# Trusted proxy IPs — set this behind a load balancer so client IPs are real.
TRUSTED_PROXIES=

# GeoIP database for country-level IP filtering (ТЗ §57). Optional.
GEOIP_DATABASE_PATH=

# ── Feature flags ────────────────────────────────────────────────────────────
FEATURE_EMBED=true
FEATURE_AB_TESTING=false
FEATURE_HEATMAPS=false
FEATURE_AI=false
# Session recording is architecturally possible but OFF by default (ТЗ §55).
FEATURE_SESSION_RECORDING=false
