# Normalise line endings in the repository to LF (correct for the Linux/Docker
# deployment target), regardless of a contributor's local core.autocrlf setting.
* text=auto

# Windows-only scripts keep CRLF so they stay runnable on Windows.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts must stay LF or they fail on Linux with
# "/bin/sh^M: bad interpreter".
*.sh text eol=lf

# Diffs for generated / data files are noise; collapse them in review views.
composer.lock -diff
*.sql linguist-language=SQL

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp4 binary
*.mp3 binary
